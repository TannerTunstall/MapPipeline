<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Israel Rocket Alerts</name>
    <description>Real-time rocket and missile alerts in Israel. Updated every 5 minutes. Last updated: Thu, May 14, 2026 08:25:09 AM (Israel Time)</description>

    <Style id="poly-critical">
      <LineStyle><color>ff0000ff</color><width>2</width></LineStyle>
      <PolyStyle><color>600000ff</color><outline>1</outline></PolyStyle>
      <BalloonStyle>
        <bgColor>ff1a1a2e</bgColor>
        <textColor>ffffffff</textColor>
      </BalloonStyle>
    </Style>
    <Style id="poly-recent">
      <LineStyle><color>ff0080ff</color><width>2</width></LineStyle>
      <PolyStyle><color>400080ff</color><outline>1</outline></PolyStyle>
      <BalloonStyle>
        <bgColor>ff1a1a2e</bgColor>
        <textColor>ffffffff</textColor>
      </BalloonStyle>
    </Style>
    <Style id="poly-moderate">
      <LineStyle><color>ff00ffff</color><width>1</width></LineStyle>
      <PolyStyle><color>3000ffff</color><outline>1</outline></PolyStyle>
      <BalloonStyle>
        <bgColor>ff1a1a2e</bgColor>
        <textColor>ffffffff</textColor>
      </BalloonStyle>
    </Style>
    <Style id="poly-old">
      <LineStyle><color>ff808080</color><width>1</width></LineStyle>
      <PolyStyle><color>20808080</color><outline>1</outline></PolyStyle>
      <BalloonStyle>
        <bgColor>ff1a1a2e</bgColor>
        <textColor>ffffffff</textColor>
      </BalloonStyle>
    </Style>
    <Folder>
        <name>Alert Zones (2)</name>
        <description>Polygon boundaries for alerted areas. Last updated: Thu, May 14, 2026 08:25:09 AM</description>

        <Placemark>
            <name>Zimrat, Shuva</name>
            <description><![CDATA[
                <div style="font-family: Arial, sans-serif; min-width: 280px;">
                    <h3 style="margin: 0 0 10px 0; color: #d32f2f;">🚨 Rocket Fire</h3>
                    <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                        <tr><td style="padding: 4px 8px 4px 0; color: #666; white-space: nowrap;">Type:</td><td style="padding: 4px 0;"><strong>Rocket Fire</strong></td></tr>
                        <tr><td style="padding: 4px 8px 4px 0; color: #666; white-space: nowrap;">Location:</td><td style="padding: 4px 0;"><strong>Zimrat, Shuva</strong></td></tr>
                        <tr><td style="padding: 4px 8px 4px 0; color: #666;">Hebrew:</td><td style="padding: 4px 0;">זמרת, שובה</td></tr>
                        <tr><td style="padding: 4px 8px 4px 0; color: #666;">Region:</td><td style="padding: 4px 0;">Gaza Envelope</td></tr>
                        <tr><td style="padding: 4px 8px 4px 0; color: #666;">Date:</td><td style="padding: 4px 0;">Thu, May 14, 2026</td></tr>
                        <tr><td style="padding: 4px 8px 4px 0; color: #666;">Elapsed:</td><td style="padding: 4px 0;"><strong>Just now</strong></td></tr>
                        <tr><td style="padding: 4px 8px 4px 0; color: #666;">Shelter:</td><td style="padding: 4px 0;">15 sec</td></tr>
                    </table>
                    <div style="margin-top: 10px; padding-top: 8px; border-top: 1px solid #eee;">
                        <div style="font-size: 11px; color: #666; margin-bottom: 4px;">Alert Time:</div>
                        <table style="width: 100%; border-collapse: collapse; font-size: 12px;">
                            <tr><td style="padding: 2px 8px 2px 0; color: #888;">🇮🇱 Israel:</td><td style="padding: 2px 0;"><strong>09:20 AM</strong></td></tr>
                            <tr><td style="padding: 2px 8px 2px 0; color: #888;">🇺🇸 Central:</td><td style="padding: 2px 0;">01:20 AM</td></tr>
                            <tr><td style="padding: 2px 8px 2px 0; color: #888;">🇬🇧 London:</td><td style="padding: 2px 0;">07:20 AM</td></tr>
                            <tr><td style="padding: 2px 8px 2px 0; color: #888;">🇸🇬 Singapore:</td><td style="padding: 2px 0;">02:20 PM</td></tr>
                        </table>
                    </div>
                    <p style="margin: 10px 0 0 0; font-size: 10px; color: #999;">Source: rocketalert.live</p>
                </div>
            ]]></description>
